#!/usr/bin/env python3
"""yt-sampler — turn a YouTube link into sampler-ready WAV clips.

A thin wrapper around yt-dlp (fetch), ffmpeg (slice/convert/normalize) and
aubio (BPM). No third-party Python packages.
"""

import argparse
import itertools
import json
import os
import random
import re
import shutil
import statistics
import subprocess
import sys
import tempfile

EXAMPLES = """examples:
  yt-sampler "https://youtu.be/VIDEO_ID"              the whole video
  yt-sampler "https://youtu.be/VIDEO_ID" 1:23         one 20s clip at 1:23
  yt-sampler "https://youtu.be/VIDEO_ID" 1:23 8       one 8s clip at 1:23
  yt-sampler "https://youtu.be/VIDEO_ID" -r           5 random 20s clips
  yt-sampler "https://youtu.be/VIDEO_ID" -r 10 -d 15  10 random 15s clips
  yt-sampler "https://youtu.be/VIDEO_ID" -r -b 4      5 random 4-bar loops

clips are named BPM-first, so `ls` sorts them by tempo
-b/--bars cuts to whole bars, so clips loop seamlessly
times accept 90, 1:30, 1:02:03 or 1m30s
always quote the URL — the ? and & in YouTube links confuse the shell
(zsh fails outright with "no matches found" on an unquoted ?)"""

DEFAULT_COUNT = 5
DEFAULT_SECONDS = 20.0
DEFAULT_PEAK_DB = -1.0
BPM_MIN, BPM_MAX = 70.0, 180.0
MIN_BEATS = 8           # fewer detected beats than this and the tempo is a guess
GAP_TOLERANCE = 0.20    # a beat gap this far off the median is treated as an outlier
MIN_CONFIDENCE = 0.5    # share of gaps that must survive the outlier filter

BEATS_PER_BAR = 4       # 4/4 throughout; odd meters would need their own flag
PROBE_SECONDS = 30.0    # window used to read tempo before a bar-locked cut


# --- small helpers -----------------------------------------------------------

def die(msg, code=1):
    print(f"yt-sampler: error: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"yt-sampler: warning: {msg}", file=sys.stderr)


def run(cmd):
    """Run a command, capturing output. Never raises on non-zero exit."""
    return subprocess.run(cmd, capture_output=True, text=True)


_UNIT_RE = re.compile(
    r"^(?:(\d+(?:\.\d+)?)h)?(?:(\d+(?:\.\d+)?)m)?(?:(\d+(?:\.\d+)?)s)?$", re.I
)


def parse_time(text):
    """Accept '90', '90.5', '1:30', '1:02:03', '1m30s', '2m', '45s'."""
    s = str(text).strip()
    if not s:
        raise ValueError("empty time value")

    try:
        return float(s)
    except ValueError:
        pass

    if ":" in s:
        parts = s.split(":")
        if len(parts) > 3 or any(not p for p in parts):
            raise ValueError(f"could not parse time {text!r}")
        total = 0.0
        for part in parts:
            total = total * 60 + float(part)
        return total

    m = _UNIT_RE.match(s)
    if m and any(m.groups()):
        h, mi, se = (float(g) if g else 0.0 for g in m.groups())
        return h * 3600 + mi * 60 + se

    raise ValueError(f"could not parse time {text!r}")


def fmt_ts(seconds):
    """Format seconds for a filename: 01m23s, or 01h04m07s past the hour."""
    total = round(seconds)
    h, rem = divmod(total, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h:02d}h{m:02d}m{s:02d}s"
    return f"{m:02d}m{s:02d}s"


def slugify(text, maxlen=60):
    s = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    if len(s) > maxlen:
        s = s[:maxlen].rstrip("-")
    return s or "sample"


def codec_for(bits):
    return "pcm_s24le" if bits == 24 else "pcm_s16le"


def unique_path(directory, stem, ext=".wav"):
    candidate = os.path.join(directory, stem + ext)
    n = 2
    while os.path.exists(candidate):
        candidate = os.path.join(directory, f"{stem}-{n}{ext}")
        n += 1
    return candidate


# --- external tools ----------------------------------------------------------

def check_tools():
    for tool in ("yt-dlp", "ffmpeg"):
        if not shutil.which(tool):
            die(f"required tool not found on PATH: {tool}")


def ytdlp_base(args):
    base = ["yt-dlp", "--no-playlist"]
    if args.cookies_from_browser:
        base += ["--cookies-from-browser", args.cookies_from_browser]
    return base


def fetch_metadata(url, args):
    proc = run([*ytdlp_base(args), "--dump-json", "--", url])
    if proc.returncode != 0:
        detail = proc.stderr.strip() or "(no output)"
        die(f"yt-dlp could not read that URL:\n{detail}")

    lines = [ln for ln in proc.stdout.splitlines() if ln.strip()]
    if not lines:
        die("yt-dlp returned no metadata for that URL")

    try:
        info = json.loads(lines[0])
    except json.JSONDecodeError as exc:
        die(f"could not parse yt-dlp metadata: {exc}")

    duration = info.get("duration")
    if not duration:
        die("that URL reports no duration — live streams aren't supported")

    title = info.get("title") or info.get("id") or "sample"
    return title, float(duration)


def download_audio(url, tmpdir, args):
    template = os.path.join(tmpdir, "src.%(ext)s")
    cmd = [*ytdlp_base(args), "-f", "bestaudio/best", "-o", template, "--", url]
    if subprocess.run(cmd).returncode != 0:
        die("yt-dlp failed to download the audio")

    found = [f for f in os.listdir(tmpdir) if f.startswith("src.")]
    if not found:
        die("the download produced no audio file")
    return os.path.join(tmpdir, found[0])


def cut(src, start, length, out, args):
    """Slice `src` to `out`. A length of None runs to the end of the stream."""
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin",
        # Microsecond precision: at 1ms a bar-locked clip lands up to ~44 samples
        # off its exact bar, which is audible drift once the clip is looped.
        "-ss", f"{start:.6f}", "-i", src,
    ]
    if length is not None:
        cmd += ["-t", f"{length:.6f}"]
    cmd += [
        "-vn",
        "-ac", "1" if args.mono else "2",
        "-ar", str(args.sr),
        "-c:a", codec_for(args.bits),
        "-y", out,
    ]
    proc = run(cmd)
    if proc.returncode != 0:
        die("ffmpeg failed while cutting:\n" + proc.stderr.strip())


_MAXVOL_RE = re.compile(r"max_volume:\s*(-?\d+(?:\.\d+)?)\s*dB")
_NUMBER_RE = re.compile(r"^\d+(?:\.\d+)?$")


def peak_normalize(path, target_db, bits):
    """Scale the clip so its loudest peak sits at target_db. Peak-only: this
    changes gain, never dynamics."""
    probe = run([
        "ffmpeg", "-hide_banner", "-nostdin", "-i", path,
        "-af", "volumedetect", "-f", "null", "-",
    ])
    match = _MAXVOL_RE.search(probe.stderr)
    if not match:
        warn(f"could not measure peak of {os.path.basename(path)}; left as-is")
        return

    gain = target_db - float(match.group(1))
    if abs(gain) < 0.1:
        return

    tmp = path + ".norm.wav"
    proc = run([
        "ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-i", path,
        "-af", f"volume={gain:.2f}dB", "-c:a", codec_for(bits), "-y", tmp,
    ])
    if proc.returncode != 0:
        warn(f"normalization failed for {os.path.basename(path)}; left as-is")
        if os.path.exists(tmp):
            os.remove(tmp)
        return
    os.replace(tmp, path)


def _fold_octave(bpm):
    """Onset detectors routinely lock onto half or double time. Fold the value
    into a musical range and round."""
    if bpm is None or not 10.0 < bpm < 1000.0:
        return None
    while bpm < BPM_MIN:
        bpm *= 2
    while bpm > BPM_MAX:
        bpm /= 2
    return round(bpm)


def _bpm_from_beat_track(path):
    """aubiotrack prints one beat timestamp per line; the gaps between them give
    the tempo. Outlier gaps (a dropped or doubled beat) are discarded first, and
    the share of gaps that survive that filter doubles as a confidence score —
    measured against known-tempo material, every correct reading scored above
    0.6 and a wrong one scored 0.31."""
    proc = run(["aubiotrack", path])
    if proc.returncode != 0:
        return None

    beats = [float(t) for t in proc.stdout.split() if _NUMBER_RE.match(t)]
    if len(beats) < MIN_BEATS:
        return None

    gaps = [b - a for a, b in itertools.pairwise(beats) if b > a]
    if len(gaps) < 3:
        return None

    median_gap = statistics.median(gaps)
    if median_gap <= 0:
        return None

    keep = [g for g in gaps if abs(g - median_gap) <= GAP_TOLERANCE * median_gap]
    if len(keep) < 3 or len(keep) / len(gaps) < MIN_CONFIDENCE:
        return None

    return 60.0 / statistics.fmean(keep)


def _bpm_from_tempo(path):
    """`aubio tempo` prints a single '<n> bpm' summary line, or 'unknown bpm'.
    Less accurate than beat tracking, so it is only a fallback."""
    proc = run(["aubio", "tempo", path])
    if proc.returncode != 0:
        return None
    try:
        return float(proc.stdout.split()[0])
    except (IndexError, ValueError):
        return None


def detect_bpm(path):
    """Best-effort tempo. Returns None whenever the reading can't be trusted —
    BPM is a nice-to-have and must never fail a run."""
    if shutil.which("aubiotrack"):
        bpm = _fold_octave(_bpm_from_beat_track(path))
        if bpm:
            return bpm
    if shutil.which("aubio"):
        return _fold_octave(_bpm_from_tempo(path))
    return None


# --- bar locking -------------------------------------------------------------

def bar_length(bpm, bars):
    """Seconds occupied by `bars` bars of 4/4 at `bpm`."""
    return bars * BEATS_PER_BAR * 60.0 / bpm


def widest_bar_length(bars):
    """Longest a bar-locked clip can possibly be.

    Tempo isn't known until each clip has been probed, but window placement has
    to happen first. Reserving the slowest-tempo length up front means the real
    clip can only ever come out shorter than its slot, so clips still can't
    overlap without any need to re-check afterwards.
    """
    return bar_length(BPM_MIN, bars)


def probe_bpm(src, start, duration, tmpdir, args):
    """Read tempo from a wide window at `start`.

    A bar-locked clip can be just a few seconds long — too short to hold the
    MIN_BEATS aubio needs — so tempo comes from a generous probe and is then
    reused for the clip itself rather than re-detected on the short result.
    """
    probe_len = min(PROBE_SECONDS, duration - start)
    probe = os.path.join(tmpdir, "probe.wav")
    cut(src, start, probe_len, probe, args)
    bpm = detect_bpm(probe)
    os.remove(probe)
    return bpm


# --- clip selection ----------------------------------------------------------

def pick_windows(duration, count, clip_len, rng, bars=None):
    """Pick `count` random windows that never overlap each other.

    Drawing starts independently would routinely produce near-duplicate clips a
    second apart. Instead of drawing and retrying on collisions, this removes the
    count * clip_len the clips will occupy from the timeline, scatters the starts
    across the free space that remains, then slides each one right by the length
    of everything before it. Any sorted set of points maps to a valid layout, so
    it succeeds in a single pass and stays uniform over the possible outcomes.
    """
    if duration <= clip_len:
        warn(
            f"video is only {duration:.1f}s, shorter than the requested "
            f"{clip_len:.0f}s clip — taking the whole thing"
        )
        return [(0.0, duration)]

    capacity = int(duration // clip_len)
    if count > capacity:
        # In bars mode clip_len is the reserved worst-case slot, not anything
        # the user asked for, so name the bars and explain where the size came from.
        size = (f"{bars}-bar (up to {clip_len:.0f}s)" if bars
                else f"{clip_len:.0f}s")
        warn(
            f"only {capacity} non-overlapping {size} clip(s) fit in "
            f"{fmt_ts(duration)} — making {capacity} instead of {count}"
        )
        count = capacity

    free = duration - count * clip_len
    offsets = sorted(rng.uniform(0.0, free) for _ in range(count))
    return [(offset + i * clip_len, clip_len) for i, offset in enumerate(offsets)]


# --- CLI ---------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="yt-sampler",
        description="Turn a YouTube link into sampler-ready WAV clips.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=EXAMPLES,
    )
    p.add_argument("url", help="YouTube URL")
    p.add_argument("pos_start", nargs="?", metavar="START",
                   help="start time; omit for the whole video")
    p.add_argument("pos_seconds", nargs="?", metavar="SECONDS",
                   help=f"clip length (default {DEFAULT_SECONDS:.0f})")

    p.add_argument("-r", "--random", nargs="?", type=int,
                   const=DEFAULT_COUNT, default=None, metavar="N",
                   help=f"instead of the whole video, take N random "
                        f"non-overlapping clips (default {DEFAULT_COUNT})")
    p.add_argument("-d", "--seconds", metavar="SECONDS",
                   help="clip length, flag form")
    p.add_argument("-b", "--bars", type=int, metavar="N",
                   help="cut clips to exactly N bars of 4/4 so they loop "
                        "seamlessly; length comes from the detected tempo")
    p.add_argument("-s", "--start", metavar="START", help="start time, flag form")
    p.add_argument("-o", "--outdir", default="samples",
                   help="output directory (default ./samples)")

    p.add_argument("--sr", type=int, default=44100, help="sample rate (default 44100)")
    p.add_argument("--bits", type=int, choices=(16, 24), default=16,
                   help="bit depth (default 16)")
    p.add_argument("--mono", action="store_true", help="downmix to mono")

    p.add_argument("--peak", type=float, default=DEFAULT_PEAK_DB,
                   help=f"target peak in dBFS (default {DEFAULT_PEAK_DB})")
    p.add_argument("--no-normalize", action="store_true",
                   help="skip peak normalization")
    p.add_argument("--no-bpm", action="store_true",
                   help="skip BPM detection")

    p.add_argument("--seed", type=int, help="seed the RNG for reproducible picks")
    p.add_argument("--cookies-from-browser", metavar="BROWSER",
                   default=os.environ.get("YTS_COOKIES_BROWSER"),
                   help="pass cookies from a browser to yt-dlp (bot-checked videos)")
    p.add_argument("--dry-run", action="store_true",
                   help="show what would be made, download nothing")
    return p


def resolve_times(args, parser):
    """Fold the positional and flag forms of start/seconds into two values."""
    raw_start = args.pos_start if args.pos_start is not None else args.start
    raw_seconds = args.pos_seconds if args.pos_seconds is not None else args.seconds

    start = None
    if raw_start is not None:
        try:
            start = parse_time(raw_start)
        except ValueError as exc:
            parser.error(str(exc))
        if start < 0:
            parser.error("start time cannot be negative")

    clip_len = DEFAULT_SECONDS
    if raw_seconds is not None:
        try:
            clip_len = parse_time(raw_seconds)
        except ValueError as exc:
            parser.error(str(exc))
    if clip_len <= 0:
        parser.error("clip length must be greater than zero")

    if start is not None and args.random is not None:
        parser.error("give a start time or --random, not both")
    if args.random is not None and args.random < 1:
        parser.error("--random must be at least 1")

    if args.bars is not None:
        if args.bars < 1:
            parser.error("--bars must be at least 1")
        if raw_seconds is not None:
            parser.error("give --bars or a clip length, not both")
        if args.no_bpm:
            parser.error("--bars needs the tempo to work out a bar — drop --no-bpm")

    length_given = raw_seconds is not None or args.bars is not None
    if length_given and start is None and args.random is None:
        parser.error(
            "a clip length on its own doesn't say what to cut — "
            "add a start time, or --random to scatter clips through the video"
        )

    return start, clip_len


def build_stem(slug, bpm, begin, length, whole, no_bpm):
    """Name a clip. BPM leads so a directory listing sorts by tempo, zero-padded
    to three digits because otherwise '130bpm' would sort before '086bpm'."""
    parts = []
    if not no_bpm:
        parts.append(f"{bpm:03d}bpm" if bpm else "xxxbpm")
    parts.append(slug)
    if not whole:
        parts.append(f"{fmt_ts(begin)}-{fmt_ts(begin + length)}")
    return "__".join(parts)


def main():
    parser = build_parser()

    # Bare invocation: argparse would print usage plus a terse "required: url".
    # Show the usage block with the examples instead — that's the moment someone
    # most needs to see what a real call looks like.
    if len(sys.argv) == 1:
        parser.print_usage()
        print(f"\n{EXAMPLES}\n")
        print("run 'yt-sampler --help' for all options")
        sys.exit(2)

    args = parser.parse_args()
    start, clip_len = resolve_times(args, parser)

    check_tools()
    if args.bars and not shutil.which("aubiotrack"):
        die("--bars needs aubio to read the tempo (brew install aubio)")
    if not args.no_bpm and not shutil.which("aubiotrack"):
        warn("aubio not found — BPM will be omitted (brew install aubio)")

    title, duration = fetch_metadata(args.url, args)
    print(f"{title}  [{fmt_ts(duration)}]")

    # Bar-locked clips get their slot sized for the slowest tempo we'd accept,
    # so the real cut can only come in shorter and can't run into its neighbour.
    if args.bars:
        clip_len = widest_bar_length(args.bars)

    whole = start is None and args.random is None
    if whole:
        # length None means "run to the end" — the reported duration can be a
        # touch off the real stream, so don't bound it.
        windows = [(0.0, None)]
    elif start is not None:
        if start >= duration:
            die(f"start {fmt_ts(start)} is past the end of the video "
                f"({fmt_ts(duration)})")
        # With --bars the real length isn't known until the tempo is read, so
        # leave the end-of-video check to the cutting loop below.
        if not args.bars and start + clip_len > duration:
            clip_len = duration - start
            warn(f"clip runs past the end — shortened to {clip_len:.1f}s")
        windows = [(start, clip_len)]
    else:
        rng = random.Random(args.seed)
        windows = pick_windows(duration, args.random, clip_len, rng, args.bars)

    if args.dry_run:
        if whole:
            print(f"\nwould write the whole video to {args.outdir}/ "
                  f"({fmt_ts(duration)})")
            return
        print(f"\nwould write {len(windows)} clip(s) to {args.outdir}/:")
        for begin, length in windows:
            if args.bars:
                print(f"  {fmt_ts(begin)} → {args.bars} bars "
                      f"(up to {length:.1f}s, exact length set by the tempo)")
            else:
                print(f"  {fmt_ts(begin)} → {fmt_ts(begin + length)}  ({length:.1f}s)")
        return

    os.makedirs(args.outdir, exist_ok=True)
    slug = slugify(title)
    written = []

    with tempfile.TemporaryDirectory(prefix="yt-sampler-") as tmpdir:
        src = download_audio(args.url, tmpdir, args)

        for index, (begin, length) in enumerate(windows, 1):
            bpm = None
            if args.bars:
                bpm = probe_bpm(src, begin, duration, tmpdir, args)
                if bpm:
                    length = bar_length(bpm, args.bars)
                else:
                    # Never emit a clip that claims to be bar-locked but isn't —
                    # a loop that doesn't loop only shows up later in the DAW.
                    length = min(DEFAULT_SECONDS, duration - begin)
                    warn(f"no reliable tempo at {fmt_ts(begin)} — falling back "
                         f"to {length:.0f}s, NOT bar-locked")
                if begin + length > duration:
                    length = duration - begin
                    bpm = None
                    warn(f"{args.bars} bars won't fit at {fmt_ts(begin)} — "
                         f"shortened to {length:.1f}s, NOT bar-locked")

            staged = os.path.join(tmpdir, f"clip{index}.wav")
            cut(src, begin, length, staged, args)

            if not args.no_normalize:
                peak_normalize(staged, args.peak, args.bits)

            if not args.bars:
                bpm = None if args.no_bpm else detect_bpm(staged)

            stem = build_stem(slug, bpm, begin, length, whole, args.no_bpm)
            final = unique_path(args.outdir, stem)
            shutil.move(staged, final)
            written.append(final)
            print(f"  → {final}")

    noun = "video" if whole else "clip(s)"
    print(f"\n{len(written)} {noun} written to {args.outdir}/")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
